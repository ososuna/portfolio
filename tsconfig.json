{
  "compilerOptions": {
    "paths": {
      "@components/*": ["src/components/*"],
      "@assets/*": ["src/assets/*"],
      "@layouts/*": ["src/layouts/*"],
      "@icons/*": ["src/icons/*"],
      "@data/*": ["src/data/*"],
      "@lib/*": ["src/lib/*"],
      "@img/*": ["src/assets/img/*"],
      "@styles/*": ["src/styles/*"],
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "extends": "astro/tsconfigs/strict"
}
