---
import { Image } from 'astro:assets';
import ProjectLinkButton from '@components/ProjectLinkButton.astro';
import { useTranslations } from '@data/i18n/ui';
import type { Locale } from '@data/i18n/locales';
import type { ProjectLinkKind } from '@lib/project-links';
import { icons } from '@icons/index';
import type { IconName } from '@icons/names';
import GitHubIcon from '@icons/GitHubIcon.astro';
import WebIcon from '@icons/WebIcon.astro';

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  technologies: { name: string; icon: IconName }[];
  links: { kind: ProjectLinkKind; url: string }[];
  locale: Locale;
}

const { title, description, image, technologies, links, locale } = Astro.props;
const t = useTranslations(locale);

const linkLabelKeys = {
  live: 'goToProject',
  source: 'sourceCode',
  'ui-source': 'ui',
  'api-source': 'restApi',
} as const satisfies Record<ProjectLinkKind, string>;

// The live site also wraps the Project image.
const liveUrl = links.find(({ kind }) => kind === 'live')?.url;
---

<div class="mb-14">
  <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
    {title}
  </h3>
  <p class="mt-2 text-sm font-normal text-gray-500 xss:text-base dark:text-gray-400">
    {description}
  </p>
  <ul class="flex flex-row flex-wrap gap-x-2">
    {
      technologies.map(({ name, icon }) => {
        const Icon = icons[icon];
        return (
          <li class="mt-4">
            <span class="flex gap-x-2 rounded-full border border-gray-300 px-2 py-1 text-sm text-gray-900 dark:border-zinc-800 dark:text-white">
              <Icon class="mt-0.5 size-4" />
              {name}
            </span>
          </li>
        );
      })
    }
  </ul>
  {
    liveUrl ? (
      <a href={liveUrl} target="_blank">
        <Image src={image} alt={title} class="mt-4" width="1920" height="1080" />
      </a>
    ) : (
      <Image src={image} alt={title} class="mt-4" width="1920" height="1080" />
    )
  }
  <footer class="mt-4 flex items-center justify-center gap-x-4">
    {
      links.map(({ kind, url }) => (
        <ProjectLinkButton href={url}>
          {kind === 'live' ? <WebIcon class="me-2 size-5" /> : <GitHubIcon class="me-2 size-4" />}
          {t('project', linkLabelKeys[kind])}
        </ProjectLinkButton>
      ))
    }
  </footer>
</div>
