---
import { Image } from 'astro:assets';
import ProjectLinkButton from '@components/ProjectLinkButton.astro';
import GitHubIcon from '@icons/GitHubIcon.astro';
import WebIcon from '@icons/WebIcon.astro';
import { useTranslations } from '@data/i18n/ui';
import type { Locale } from '@data/i18n/locales';

interface Props {
  title: string;
  description: string;
  link?: string;
  github?: string;
  restApi?: string;
  ui?: string;
  image: string;
  locale: Locale;
  tags: { name: string; class: string; icon: typeof GitHubIcon }[];
}

const { title, description, link, github, image, tags, restApi, ui, locale } = Astro.props;
const t = useTranslations(locale);
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/projects/*.png');
if (!images[image])
  throw new Error(`"${image}" does not exist in glob: "/src/assets/img/projects/*.png"`);
---

<div class="mb-14">
  <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
    {title}
  </h3>
  <p class="mt-2 text-sm font-normal text-gray-500 xss:text-base dark:text-gray-400">
    {description}
  </p>
  <ul class="flex flex-row flex-wrap gap-x-2">
    {
      tags.map((tag) => (
        <li class="mt-4">
          <span class={`flex gap-x-2 rounded-full text-sm ${tag.class} px-2 py-1`}>
            <tag.icon class="mt-0.5 size-4" />
            {tag.name}
          </span>
        </li>
      ))
    }
  </ul>
  {
    link ? (
      <a href={link} target="_blank">
        <Image src={images[image]()} alt={title} class="mt-4" width="1920" height="1080" />
      </a>
    ) : (
      <Image src={images[image]()} alt={title} class="mt-4" width="1920" height="1080" />
    )
  }
  <footer class="mt-4 flex items-center justify-center gap-x-4">
    {
      github && (
        <ProjectLinkButton href={github}>
          <GitHubIcon class="me-2 size-4" />
          {t('project', 'sourceCode')}
        </ProjectLinkButton>
      )
    }
    {
      ui && (
        <ProjectLinkButton href={ui}>
          <GitHubIcon class="me-2 size-4" />
          {t('project', 'ui')}
        </ProjectLinkButton>
      )
    }
    {
      restApi && (
        <ProjectLinkButton href={restApi}>
          <GitHubIcon class="me-2 size-4" />
          {t('project', 'restApi')}
        </ProjectLinkButton>
      )
    }
    {
      link && (
        <ProjectLinkButton href={link}>
          <WebIcon class="me-2 size-5" />
          {t('project', 'goToProject')}
        </ProjectLinkButton>
      )
    }
  </footer>
</div>
