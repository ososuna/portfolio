---
import { Image } from 'astro:assets';
import { badgeVariants } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { useTranslations } from '@data/i18n/ui';
import type { Locale } from '@data/i18n/locales';
import { getReferenced, type Project } from '@lib/content';
import { srcsetWidths } from '@lib/images';
import { icons } from '@icons/index';
import GitHubIcon from '@icons/GitHubIcon.astro';
import WebIcon from '@icons/WebIcon.astro';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const { title, description, image, links } = project;
const technologies = await Promise.all(project.technologies.map(getReferenced));
const t = useTranslations(locale);

const liveUrl = links.find(({ kind }) => kind === 'live')?.url;

// The image fills the Section: 760px from `lg` up, the screen less its margins below. The
// widest candidate covers that at double density.
const imageWidths = srcsetWidths({ sourceWidth: image.width, widths: [640, 960, 1520] });
const imageProps = {
  src: image,
  alt: title,
  width: imageWidths.at(-1),
  widths: imageWidths,
  sizes: '(min-width: 1024px) 760px, calc(100vw - 3rem)',
};
---

<article class="mb-14">
  <h3 class="text-xl font-semibold">
    {title}
  </h3>
  <p class="mt-2 text-sm text-muted-foreground xss:text-base">
    {description}
  </p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {
      technologies.map(({ name, icon }) => {
        const Icon = icons[icon];
        return (
          <li>
            <span
              class={cn(
                badgeVariants({ variant: 'outline' }),
                'h-6 gap-1.5 px-2.5 text-sm [&>svg]:size-3.5!',
              )}
            >
              <Icon aria-hidden="true" />
              {name}
            </span>
          </li>
        );
      })
    }
  </ul>
  {
    liveUrl ? (
      <a href={liveUrl} target="_blank" class="mt-4 block overflow-hidden rounded-lg border">
        <Image {...imageProps} />
      </a>
    ) : (
      <Image {...imageProps} class="mt-4 rounded-lg border" />
    )
  }
  <footer class="mt-4 flex flex-wrap items-center justify-center gap-2">
    {
      links.map(({ kind, url }) => (
        <a href={url} target="_blank" class={cn(buttonVariants({ variant: 'outline' }))}>
          {kind === 'live' ? <WebIcon aria-hidden="true" /> : <GitHubIcon aria-hidden="true" />}
          {t(`project.${kind}`)}
        </a>
      ))
    }
  </footer>
</article>
