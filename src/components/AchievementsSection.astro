---
import { getImage } from 'astro:assets';
import Achievement from '@components/Achievement';
import SectionContainer from '@components/SectionContainer.astro';
import { useTranslations } from '@data/i18n/ui';
import type { Locale } from '@data/i18n/locales';
import { getLocalized } from '@lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const { achievements } = await getLocalized({ collection: 'achievements', locale });
// The Card is React, which cannot use Astro's <Image>, so the optimized image is built here.
const imageSize = { width: 1920, height: 1080 };
const images = await Promise.all(
  achievements.map(({ image }) => getImage({ src: image, ...imageSize })),
);
---

<SectionContainer id="achievements" class="py-16">
  <h2 class="mb-10 text-center text-2xl font-bold text-foreground xss:text-3xl">
    {t('sections.achievements')}
  </h2>
  <div
    class="flex flex-col items-center justify-center md:flex-row md:items-start md:space-x-4 lg:space-x-8"
  >
    {
      achievements.map(({ title, description, link }, index) => (
        <Achievement
          title={title}
          description={description}
          image={{ src: images[index].src, ...imageSize }}
          link={link}
          learnMoreLabel={t('achievement.learnMore')}
        />
      ))
    }
  </div>
</SectionContainer>
