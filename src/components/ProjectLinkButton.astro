---
const { href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  class="me-2 mb-2 inline-flex items-center rounded-lg border border-gray-300 bg-white px-5 py-2 text-center text-sm font-medium text-gray-900 hover:bg-gray-100 focus:ring-4 focus:ring-gray-200 focus:outline-none dark:border-zinc-800 dark:bg-zinc-950 dark:text-white dark:hover:bg-zinc-800 dark:focus:ring-gray-700"
>
  <slot />
</a>
