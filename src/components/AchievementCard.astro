---
import { Image } from 'astro:assets';
import { useTranslations } from '@data/i18n/ui';
import type { Lang } from '@data/i18n/utils';

interface Props {
  title: string;
  description: string;
  image: string;
  link?: string;
  lang: Lang;
}
const { title, description, image, link, lang }: Props = Astro.props;
const t = useTranslations(lang);

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/achievements/*.jpg');
if (!images[image])
  throw new Error(`"${image}" does not exist in glob: "/src/assets/img/achievements/*.jpg"`);
---

<div
  class="mb-6 max-w-sm rounded-lg border border-gray-200 bg-white shadow md:w-1/2 dark:border-zinc-800 dark:bg-zinc-950"
>
  <Image class="rounded-t-lg" src={images[image]()} alt={title} width="1920" height="1080" />
  <div class="p-5">
    <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
      {title}
    </h3>
    <p class="mt-2 text-sm font-normal text-gray-500 xss:text-base dark:text-gray-400">
      {description}
    </p>
    {
      link && (
        <a
          href={link}
          target="_blank"
          class="me-2 mt-3 mb-2 inline-flex items-center rounded-lg border border-gray-300 bg-white px-5 py-2 text-center text-sm font-medium text-gray-900 hover:bg-gray-100 focus:ring-4 focus:ring-gray-200 focus:outline-none dark:border-zinc-800 dark:bg-zinc-950 dark:text-white dark:hover:bg-zinc-800 dark:focus:ring-gray-700"
        >
          {t('achievement', 'learnMore')}
          <svg
            class="ms-2 h-3.5 w-3.5 rtl:rotate-180"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 14 10"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M1 5h12m0 0L9 1m4 4L9 9"
            />
          </svg>
        </a>
      )
    }
  </div>
</div>
