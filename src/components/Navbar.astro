---
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import ThemeToggle from '@components/ThemeToggle';
import LocaleToggle from '@components/LocaleToggle';
import LogoIcon from '@icons/LogoIcon.astro';
import { useTranslations } from '@data/i18n/ui';
import type { Locale } from '@data/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const menuOptions = [
  {
    name: t('nav.experience'),
    label: t('nav.experience').toLowerCase(),
    url: locale === 'es' ? '/es/#experience' : '/#experience',
  },
  {
    name: t('nav.projects'),
    label: t('nav.projects').toLowerCase(),
    url: locale === 'es' ? '/es/#projects' : '/#projects',
  },
  {
    name: t('nav.achievements'),
    label: t('nav.achievements').toLowerCase(),
    url: locale === 'es' ? '/es/#achievements' : '/#achievements',
  },
  {
    name: t('nav.about'),
    label: t('nav.about').toLowerCase(),
    url: locale === 'es' ? '/es/#about-me' : '/#about-me',
  },
];
---

<header
  class="fixed z-50 flex h-14 w-full items-center justify-center border-b bg-background/80 backdrop-blur xs:justify-between xs:px-6"
>
  <a
    href={locale === 'es' ? '/es/#' : '/#'}
    aria-label={t('nav.home')}
    class="block xss:hidden xs:block"
  >
    <LogoIcon />
  </a>
  <nav class="flex items-center gap-1 xs:gap-2">
    {
      menuOptions.map((option) => (
        <a
          class={cn(
            buttonVariants({ variant: 'ghost', size: 'sm' }),
            'hidden text-muted-foreground xss:inline-flex',
          )}
          aria-label={option.label}
          href={option.url}
        >
          {option.name}
        </a>
      ))
    }
    <LocaleToggle client:load locale={locale} label={t('controls.switchLocale')} />
    <ThemeToggle client:load label={t('controls.toggleTheme')} />
  </nav>
</header>
