---
import OracleIcon from '@icons/OracleIcon.astro';
import GEIcon from '@icons/GEIcon.astro';
import ArcosIcon from '@icons/ArcosIcon.astro';
interface Props {
  date: string;
  title: string;
  bulletPoints?: string[];
  company: string;
}
const { date, title, bulletPoints, company } = Astro.props;
---

<li class="ms-8 me-6 mb-10 lg:me-0">
  <span
    class="absolute -start-3 flex h-6 w-6 items-center justify-center rounded-full bg-zinc-50 p-0.5 dark:bg-white"
  >
    {company === 'ARCOS LLC' && <ArcosIcon />}
    {company === 'Oracle' && <OracleIcon />}
    {company === 'GE Aerospace' && <GEIcon />}
  </span>
  <time class="mb-1 text-sm leading-none font-normal text-zinc-400 dark:text-gray-400">
    {date}
  </time>
  <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
    {title}
  </h3>
  <ul
    class="list-outside list-disc space-y-1 pl-4 text-sm font-normal text-gray-500 xss:text-base dark:text-gray-400"
  >
    {bulletPoints?.map((point) => <li>{point}</li>)}
  </ul>
</li>
